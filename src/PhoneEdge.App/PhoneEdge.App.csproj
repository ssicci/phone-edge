<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 알림(토스트) API 를 쓰기 위해 Windows 10 2004 이상을 대상으로 한다. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>PhoneEdge.App</RootNamespace>
    <AssemblyName>PhoneEdge</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhoneEdge.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhoneEdge.Contracts\PhoneEdge.Contracts.csproj" />
    <ProjectReference Include="..\PhoneEdge.Phone\PhoneEdge.Phone.csproj" />
  </ItemGroup>

  <!-- 실행 파일 옆 tools\ 에 adb 와 scrcpy 서버를 함께 둔다. -->
  <ItemGroup>
    <None Include="..\..\tools\platform-tools\adb.exe;..\..\tools\platform-tools\AdbWinApi.dll;..\..\tools\platform-tools\AdbWinUsbApi.dll;..\..\tools\scrcpy-server"
          Link="tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
