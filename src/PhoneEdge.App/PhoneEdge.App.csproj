<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 알림(토스트) API 를 쓰기 위해 Windows 10 2004 이상을 대상으로 한다. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>PhoneEdge.App</RootNamespace>
    <AssemblyName>PhoneEdge</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- 프레임워크의 언어별 위성 어셈블리는 앱이 지원하는 언어(en, ko)만 배포한다. -->
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhoneEdge.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhoneEdge.Contracts\PhoneEdge.Contracts.csproj" />
    <ProjectReference Include="..\PhoneEdge.Phone\PhoneEdge.Phone.csproj" />
  </ItemGroup>

  <!-- 실행 파일 옆 tools\ 에 adb 와 scrcpy 서버를 함께 둔다. -->
  <ItemGroup>
    <None Include="..\..\tools\platform-tools\adb.exe;..\..\tools\platform-tools\AdbWinApi.dll;..\..\tools\platform-tools\AdbWinUsbApi.dll;..\..\tools\scrcpy-server" Link="tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- 폰 도우미 앱 APK. android/ 에서 release 로 빌드해 두었으면 tools\companion.apk 로 함께 둔다 (없으면 건너뛴다). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\android\app\build\outputs\apk\release\app-release.apk')">
    <None Include="..\..\android\app\build\outputs\apk\release\app-release.apk"
          Link="tools\companion.apk" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 배포물에 포함할 제3자 라이선스 고지 (tools/fetch-tools.ps1 이 tools/dl/licenses 에 받는다). -->
  <ItemGroup>
    <None Include="..\..\tools\dl\licenses\*;..\..\THIRD-PARTY-NOTICES.md"
          Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
